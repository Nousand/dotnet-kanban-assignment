@page "{id:guid}"
@model BoardModel
@{
    var board = Model.Board!;
    ViewData["Title"] = board.Name;
}

<div class="mb-6 grid grid-cols-3 items-center">
    <div class="flex items-center gap-2">
        <a asp-page="/Index" class="text-muted hover:text-white">&larr;</a>
        <h1 class="font-medium">@board.Name</h1>
    </div>

    <nav class="flex justify-center gap-1">
        <span class="rounded bg-white/10 px-3 py-1">Board</span>
        <span class="cursor-not-allowed rounded px-3 py-1 text-muted" title="Coming soon">Dashboard</span>
    </nav>

    <div class="flex justify-end">
        <span class="cursor-not-allowed text-muted" title="Coming soon">Export</span>
    </div>
</div>

<div class="flex min-h-96 items-start gap-10 overflow-x-auto pb-4">
    <div id="group-list" class="flex items-start gap-10">
        @foreach (var group in board.Groups)
        {
            <partial name="_Group" model="group" />
        }
    </div>

    <details class="relative shrink-0">
        <summary class="flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-md bg-card text-xl text-muted hover:bg-white/10">+</summary>
        <form method="post" asp-page-handler="CreateGroup"
              hx-post="?handler=CreateGroup" hx-target="#group-list" hx-swap="beforeend"
              hx-on::after-request="if(event.detail.successful) { this.reset(); this.closest('details').open = false }"
              class="absolute left-0 z-10 mt-2 flex w-64 flex-col gap-2 rounded-md bg-card p-3 shadow-lg ring-1 ring-white/10">
            <input name="name" placeholder="Group name" aria-label="Group name" required maxlength="100"
                   class="rounded bg-surface px-2 py-1" />
            <input type="color" name="colour" value="#3b82f6" aria-label="Group colour" class="h-8 w-full rounded" />
            <button type="submit" class="rounded bg-white/10 px-2 py-1 hover:bg-white/20">Add group</button>
        </form>
    </details>
</div>