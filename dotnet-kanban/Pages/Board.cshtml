@page "{id:guid}"
@model BoardModel
@{
    var board = Model.Board!;
    ViewData["Title"] = board.Name;
}

<div class="mb-6">
    <a asp-page="/Index" class="text-sm text-blue-700 hover:underline">&larr; All boards</a>
    <h1 class="mt-2 text-2xl font-bold">@board.Name</h1>
</div>

<div class="flex items-start gap-4 overflow-x-auto pb-4">
    @foreach (var group in board.Groups)
    {
        <section class="flex w-72 shrink-0 flex-col rounded-lg bg-gray-200">
            <header class="flex items-center gap-2 rounded-t-lg px-3 py-2 text-white" style="background-color: @group.Colour">
                <h2 class="flex-1 truncate font-semibold">@group.Name</h2>
                <span class="rounded-full bg-black/20 px-2 py-0.5 text-xs">@group.TaskCount</span>
            </header>

            <div class="flex flex-col gap-2 p-2">
                @if (group.Tasks.Count == 0)
                {
                    <p class="px-1 py-2 text-sm text-gray-500">No tasks yet.</p>
                }
                else
                {
                    @foreach (var task in group.Tasks)
                    {
                        <article class="rounded-md border border-gray-200 bg-white p-3 shadow-sm">
                            <h3 class="font-medium">@task.Title</h3>

                            @if (task.Tags.Count > 0)
                            {
                                <div class="mt-2 flex flex-wrap gap-1">
                                    @foreach (var tag in task.Tags)
                                    {
                                        <span class="rounded px-1.5 py-0.5 text-xs text-white" style="background-color: @tag.Colour">@tag.Title</span>
                                    }
                                </div>
                            }

                            <div class="mt-2 flex items-center justify-between text-xs text-gray-500">
                                @if (task.Priority != Priority.None)
                                {
                                    var priorityClasses = task.Priority switch
                                    {
                                        Priority.High => "bg-red-100 text-red-700",
                                        Priority.Medium => "bg-amber-100 text-amber-700",
                                        _ => "bg-green-100 text-green-700"
                                    };
                                    <span class="rounded px-1.5 py-0.5 font-medium @priorityClasses">@task.Priority</span>
                                }
                                @if (task.DueDate is not null)
                                {
                                    <span>Due @task.DueDate.Value.ToString("MMM d")</span>
                                }
                            </div>
                        </article>
                    }
                }
            </div>
        </section>
    }

    @if (board.Groups.Count == 0)
    {
        <p class="text-gray-500">This board has no groups yet.</p>
    }
</div>
