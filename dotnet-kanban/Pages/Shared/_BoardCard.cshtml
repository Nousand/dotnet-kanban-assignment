@model Board

<div class="board-card flex flex-col gap-3 rounded-md bg-card p-4">
    <a asp-page="/Board" asp-route-id="@Model.Id" class="text-lg font-semibold hover:underline">
        @Model.Name
    </a>

    <div class="mt-auto flex items-center gap-2">
        <form method="post" asp-page-handler="Rename"
              hx-post="?handler=Rename" hx-target="closest .board-card" hx-swap="outerHTML"
              class="flex flex-1 gap-2">
            <input type="hidden" name="id" value="@Model.Id" />
            <input name="name" value="@Model.Name" aria-label="Board name" required
                   class="w-full rounded bg-surface px-2 py-1" />
            <button type="submit" class="rounded bg-white/10 px-2 py-1 hover:bg-white/20">Rename</button>
        </form>

        <form method="post" asp-page-handler="Delete"
              hx-post="?handler=Delete" hx-target="closest .board-card" hx-swap="delete"
              hx-confirm="Delete &quot;@Model.Name&quot; and all of its groups and tasks?">
            <input type="hidden" name="id" value="@Model.Id" />
            <button type="submit" class="rounded px-2 py-1 text-red-400 hover:bg-white/10">Delete</button>
        </form>
    </div>
</div>