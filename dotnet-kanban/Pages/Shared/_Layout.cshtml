<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - dotnet_kanban</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/tailwind.css" asp-append-version="true" />
    <link rel="icon" href="~/favicon.ico" />
    @* No defer: keeps htmx defined before the bottom-of-body scripts (site.js) run. *@
    <script src="~/js/htmx.min.js"></script>
</head>
<body class="min-h-screen bg-surface text-sm text-zinc-200 antialiased">
    <!--<header class="flex h-12 items-center px-4">
        <a asp-page="/Index" class="font-medium hover:text-white">dotnet_kanban</a>
    </header>-->

    <main class="px-4 py-4">
        @RenderBody()
    </main>

    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>