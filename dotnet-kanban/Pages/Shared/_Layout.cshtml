<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - dotnet_kanban</title>
    <link rel="stylesheet" href="~/css/tailwind.css" asp-append-version="true" />
    <link rel="icon" href="~/favicon.ico" />
</head>
<body class="flex min-h-screen flex-col bg-gray-100 text-gray-900">
    <header class="border-b border-gray-200 bg-white">
        <nav class="mx-auto flex max-w-7xl items-center px-4 py-3">
            <a asp-page="/Index" class="text-xl font-semibold tracking-tight">dotnet_kanban</a>
        </nav>
    </header>

    <main class="mx-auto w-full max-w-7xl flex-1 px-4 py-6">
        @RenderBody()
    </main>

    <footer class="border-t border-gray-200 bg-white py-3 text-center text-sm text-gray-500">
        &copy; 2026 - dotnet_kanban
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
