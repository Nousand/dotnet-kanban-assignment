@model TaskEditViewModel
@{
    var task = Model.Task;
    var boardTags = Model.BoardTags;
}

<div class="mb-2 flex justify-end">
    <form method="post" asp-page-handler="DeleteTask"
          hx-post="?handler=DeleteTask" hx-target="#task-card-@task.Id" hx-swap="delete"
          hx-confirm="Delete this task? This cannot be undone.">
        <input type="hidden" name="taskId" value="@task.Id" />
        <button type="submit"
                class="rounded bg-red-900 px-2 py-1 text-xs font-semibold text-white hover:bg-red-800">
            Delete task
        </button>
    </form>
</div>

<section class="flex flex-col rounded-xl bg-card p-1 shadow-xl ring-1 ring-white/10 sm:p-5">
    <form id="task-edit-form-@task.Id" method="post" asp-page-handler="UpdateTask"
          hx-post="?handler=UpdateTask" hx-target="#task-modal-content" hx-swap="innerHTML">
        <input type="hidden" name="taskId" value="@task.Id" />
    </form>

    <header class="mb-2 flex items-start justify-between gap-4">
            <input name="title" value="@task.Title" required maxlength="200" aria-label="Task title"
                   form="task-edit-form-@task.Id"
                   class="min-w-0 flex-1 rounded bg-transparent px-1 text-2xl font-bold leading-tight text-white focus:bg-surface focus:outline-none" />
            <div class="flex shrink-0 items-center gap-1 text-muted">
                <button type="submit" form="task-edit-form-@task.Id"
                        class="rounded-lg p-2 text-emerald-300 hover:text-emerald-200"
                        aria-label="Save task edits" title="Save">
                    <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6">
                        <path d="m5 12 4 4L19 6"></path>
                    </svg>
                </button>
                <button type="button"
                        hx-get="?handler=ViewTask&amp;taskId=@task.Id"
                        hx-target="#task-modal-content" hx-swap="innerHTML"
                        class="rounded-lg p-2 hover:text-white"
                        aria-label="Cancel editing" title="Cancel">
                    <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6">
                        <path d="m18 6-12 12"></path>
                        <path d="m6 6 12 12"></path>
                    </svg>
                </button>
            </div>
    </header>

    <div class="mb-2">
        <div id="selected-task-tags-@task.Id" data-selected-task-tags class="mb-2 flex flex-wrap gap-3">
            @foreach (var tag in task.Tags)
            {
                <span data-tag-id="@tag.Id"
                      class="inline-flex items-center gap-1 rounded-full px-3.5 py-1 text-base font-semibold uppercase leading-5 text-white"
                      style="background-color: @tag.Colour">
                    <input type="hidden" name="tagIds" value="@tag.Id" form="task-edit-form-@task.Id" />
                    <span>@tag.Title</span>
                    <button type="button" data-remove-task-tag
                            class="ml-1 rounded-full text-white/80 hover:text-white"
                            aria-label="Remove @tag.Title tag">×</button>
                </span>
            }
        </div>

        <div data-task-tag-controls class="flex max-w-sm items-center gap-2">
            <select id="task-tags-@task.Id" data-task-tag-picker
                    class="min-w-0 flex-1 rounded bg-surface/70 px-2 py-1 text-sm text-muted focus:outline-none focus:ring-1 focus:ring-white/20"
                    aria-label="Choose an existing board tag">
                <option value="">Choose a tag</option>
                @foreach (var tag in boardTags)
                {
                    <option value="@tag.Id" data-colour="@tag.Colour"
                            disabled="@(task.Tags.Any(selected => selected.Id == tag.Id))">@tag.Title</option>
                }
            </select>

            <details id="task-tag-popup-@task.Id" class="relative" data-task-tag-popup>
                <summary class="cursor-pointer list-none whitespace-nowrap px-2 py-1 text-sm text-muted hover:text-white"
                         aria-label="Add a new tag" title="Add a new tag">
                    + Add tag
                </summary>
                <form method="post" asp-page-handler="AddTaskTag"
                      hx-post="?handler=AddTaskTag"
                      hx-target="#selected-task-tags-@task.Id"
                      hx-swap="beforeend"
                      hx-on::after-request="if(event.detail.successful) { this.reset(); this.closest('details').open = false }"
                      data-create-task-tag
                      class="absolute left-0 z-20 mt-2 flex w-64 flex-col gap-2 rounded-md bg-card p-3 shadow-lg ring-1 ring-white/10">
                    <input type="hidden" name="taskId" value="@task.Id" />
                    <input name="title" placeholder="Tag name" aria-label="Tag name" required maxlength="50"
                           class="rounded bg-surface px-2 py-1" />
                    <input type="color" name="colour" value="#3b82f6" aria-label="Tag colour" class="h-8 w-full rounded" />
                    <button type="submit" class="rounded bg-white/10 px-2 py-1 hover:bg-white/20">Add tag</button>
                </form>
            </details>
        </div>
    </div>

    <hr class="mb-2 border-t border-white/10" />

    <div class="flex flex-1">
        <textarea id="task-description-@task.Id" name="description" form="task-edit-form-@task.Id" rows="7"
                  class="min-h-40 w-full flex-1 resize-y rounded bg-transparent px-1 text-xl text-white focus:bg-surface focus:outline-none"
                  aria-label="Task description">@task.Description</textarea>
    </div>

    <footer class="mt-8 flex flex-wrap items-end justify-between gap-4 text-lg text-muted">
            <div data-due-date-control class="flex flex-wrap items-center gap-2">
                <input type="datetime-local" name="dueDate" form="task-edit-form-@task.Id" data-due-date-input
                       value="@(task.DueDate?.ToString("yyyy-MM-ddTHH:mm"))"
                       class="rounded bg-surface px-2 py-1 text-base @(task.DueDate is null ? "hidden" : "")"
                       aria-label="Task due date and time" />
                <button type="button" data-due-date-action="add"
                        class="rounded px-2 py-1 hover:text-white @(task.DueDate is not null ? "hidden" : "")">
                    Add due date
                </button>
                <button type="button" data-due-date-action="remove"
                        class="rounded px-2 py-1 text-red-300 @(task.DueDate is null ? "hidden" : "")">
                    Remove
                </button>
            </div>

            <div class="flex shrink-0 items-center gap-2">
                <label for="task-priority-@task.Id">Priority</label>
                <select id="task-priority-@task.Id" name="priority" form="task-edit-form-@task.Id"
                        class="rounded bg-transparent px-1 py-1 text-right focus:bg-surface focus:outline-none">
                    @foreach (var priority in Enum.GetValues<Priority>())
                    {
                        <option value="@((int)priority)" selected="@(task.Priority == priority)">@priority</option>
                    }
                </select>
            </div>
    </footer>
</section>
