@model Group

<section class="group-card flex w-60 shrink-0 flex-col gap-2" data-group-card data-group-id="@Model.Id">
    <header draggable="true" data-group-drag-handle
            class="flex h-10 cursor-grab items-center gap-2 rounded-md bg-card px-3 active:cursor-grabbing"
            style="border-left: 4px solid @Model.Colour">
        <h2 class="flex-1 truncate font-semibold">@Model.Name</h2>
        <span id="task-count-@Model.Id" class="task-count rounded bg-white/10 px-2 text-sm text-muted">@Model.TaskCount</span>

        <details class="relative">
            <summary class="cursor-pointer list-none rounded px-1 text-muted hover:bg-white/10">•••</summary>
            <div class="absolute right-0 z-10 mt-1 w-56 rounded-md bg-card p-3 shadow-lg ring-1 ring-white/10">
                <form method="post" asp-page-handler="EditGroup"
                      hx-post="?handler=EditGroup" hx-target="closest .group-card" hx-swap="outerHTML"
                      class="flex gap-2">
                    <input type="hidden" name="groupId" value="@Model.Id" />
                    <input name="name" value="@Model.Name" required maxlength="100" aria-label="Group name"
                           class="w-full rounded bg-surface px-2 py-1 text-sm text-zinc-100" />
                    <input type="color" name="colour" value="@Model.Colour" aria-label="Group colour"
                           class="h-8 w-8 rounded" />
                    <button type="submit"
                            class="rounded bg-white/10 px-2 py-1 text-sm text-zinc-100 hover:bg-white/20">Save</button>
                </form>

                <form method="post" asp-page-handler="DeleteGroup"
                      hx-post="?handler=DeleteGroup" hx-target="closest .group-card" hx-swap="delete"
                      hx-confirm="Delete &quot;@Model.Name&quot; and all of its tasks?"
                      class="mt-2">
                    <input type="hidden" name="groupId" value="@Model.Id" />
                    <button type="submit"
                            class="w-full rounded px-2 py-1 text-left text-sm text-red-400 hover:bg-white/10">
                        Delete group
                    </button>
                </form>
            </div>
        </details>
    </header>

    <div id="task-list-@Model.Id" class="flex min-h-2 flex-col gap-2"
         data-task-list data-group-id="@Model.Id">
        @foreach (var task in Model.Tasks)
        {
            <partial name="_TaskCard" model="task" />
        }
    </div>

    <form method="post" asp-page-handler="CreateTask"
          hx-post="?handler=CreateTask" hx-target="#task-list-@Model.Id" hx-swap="beforeend"
          aria-label="Add task to @Model.Name">
        <input type="hidden" name="groupId" value="@Model.Id" />
        <button type="submit" class="w-full rounded-md bg-card py-1 text-lg text-muted hover:bg-white/10"
                aria-label="Add task">+</button>
    </form>
</section>