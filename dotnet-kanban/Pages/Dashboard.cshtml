@page "{id:guid}"
@model DashboardModel
@{
    var board = Model.Board!;
    var stats = Model.Stats;
    ViewData["Title"] = $"{board.Name} – Dashboard";

    // The "untagged" row only makes sense when some tasks have no tag.
    var tagRows = new List<CountRow>(stats.TasksPerTag);
    if (stats.UntaggedTasks > 0)
        tagRows.Add(new CountRow("Untagged", "#71717a", stats.UntaggedTasks));
}

<div class="mb-6 grid grid-cols-3 items-center">
    <div class="flex items-center gap-2">
        <a asp-page="/Index" class="text-muted hover:text-white">&larr;</a>
        <h1 class="font-medium">@board.Name</h1>
    </div>

    <nav class="flex justify-center gap-1">
        <a asp-page="/Board" asp-route-id="@board.Id"
           class="rounded px-3 py-1 text-muted hover:bg-white/10 hover:text-white">Board</a>
        <span class="rounded bg-white/10 px-3 py-1">Dashboard</span>
    </nav>

    <div class="flex justify-end">
        <a asp-page="/Board" asp-route-id="@board.Id" asp-route-handler="Export"
           class="text-muted hover:text-white">Export</a>
    </div>
</div>

<div class="mb-6 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-5">
    <div class="rounded-md bg-card p-4">
        <p class="text-muted">Tasks</p>
        <p class="mt-1 text-2xl font-semibold">@stats.TotalTasks</p>
    </div>
    <div class="rounded-md bg-card p-4">
        <p class="text-muted">Groups</p>
        <p class="mt-1 text-2xl font-semibold">@stats.GroupCount</p>
    </div>
    <div class="rounded-md bg-card p-4">
        <p class="text-muted">Tags</p>
        <p class="mt-1 text-2xl font-semibold">@stats.TagCount</p>
    </div>
    <div class="rounded-md bg-card p-4">
        <p class="text-muted">Overdue</p>
        <p class="mt-1 text-2xl font-semibold @(stats.Overdue > 0 ? "text-red-400" : "")">@stats.Overdue</p>
    </div>
    <div class="rounded-md bg-card p-4">
        <p class="text-muted">Due in 7 days</p>
        <p class="mt-1 text-2xl font-semibold @(stats.DueSoon > 0 ? "text-amber-400" : "")">@stats.DueSoon</p>
    </div>
</div>

<div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
    <section class="rounded-md bg-card p-4">
        <h2 class="mb-4 font-semibold">Tasks per group</h2>
        <partial name="_StatList" model="stats.TasksPerGroup" />
    </section>

    <section class="rounded-md bg-card p-4">
        <h2 class="mb-4 font-semibold">Tasks per tag</h2>
        @if (tagRows.Count > 0)
        {
            <partial name="_StatList" model="tagRows" />
        }
        else
        {
            <p class="text-muted">No tags yet.</p>
        }
    </section>

    <section class="rounded-md bg-card p-4">
        <h2 class="mb-4 font-semibold">Tasks per priority</h2>
        <partial name="_StatList" model="stats.TasksPerPriority" />
    </section>

    <section class="rounded-md bg-card p-4">
        <h2 class="mb-4 font-semibold">Due dates</h2>
        <partial name="_StatList" model="stats.TasksPerDueDate" />
    </section>

    <section class="rounded-md bg-card p-4 lg:col-span-2">
        <h2 class="mb-4 font-semibold">Tasks per board</h2>
        @if (Model.BoardCounts.Count == 0)
        {
            <p class="text-muted">No boards yet.</p>
        }
        else
        {
            var max = Math.Max(1, Model.BoardCounts.Max(b => b.TaskCount));
            <ul class="flex flex-col gap-3">
                @foreach (var item in Model.BoardCounts)
                {
                    var current = item.Id == board.Id;
                    var colour = current ? "#3b82f6" : "#71717a";
                    var width = item.TaskCount == 0 ? 0 : Math.Max(2, item.TaskCount * 100 / max);
                    <li class="@(current ? "-m-1 rounded bg-white/5 p-1" : "")">
                        <div class="mb-1 flex items-center justify-between gap-2">
                            <a asp-page="/Board" asp-route-id="@item.Id"
                               class="flex min-w-0 items-center gap-2 @(current ? "font-semibold text-white" : "text-zinc-200 hover:text-white")">
                                <span class="h-2.5 w-2.5 shrink-0 rounded-full"
                                      style="background-color: @colour" aria-hidden="true"></span>
                                <span class="truncate">@item.Name</span>
                            </a>
                            <span class="text-muted">@item.TaskCount</span>
                        </div>
                        <div class="h-1.5 overflow-hidden rounded-full bg-white/5">
                            <div class="h-full rounded-full"
                                 style="width: @width%; background-color: @colour"></div>
                        </div>
                    </li>
                }
            </ul>
        }
    </section>
</div>
